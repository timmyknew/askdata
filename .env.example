# 复制一份改名为 .env，在等号后面填上自己的 key。.env 不会被提交（见 .gitignore）。
# 至少填一个：DeepSeek（便宜、效果好）或智谱（GLM-4-Flash 免费）。
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=

# 下面三项是公开演示用的，本地运行保持默认即可；部署时填在平台的环境变量里，见 docs/deploy.md。
# 每个访客最多问几次，0 表示不限。
ASKDATA_MAX_QUESTIONS=0
# 全站每天最多回答几次，0 表示不限。
ASKDATA_DAILY_LIMIT=0
# 只开放哪些模型，用逗号隔开，比如 deepseek-flash,glm-4-flash；空着表示全部。
ASKDATA_MODELS=
